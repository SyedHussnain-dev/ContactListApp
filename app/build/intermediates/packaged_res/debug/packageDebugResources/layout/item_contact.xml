<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/contact_row_min_height"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/contact_row_padding_vertical"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingEnd="8dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Avatar container -->
    <FrameLayout
        android:layout_width="@dimen/avatar_size"
        android:layout_height="@dimen/avatar_size">

        <TextView
            android:id="@+id/avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="@dimen/avatar_text_size"
            android:textStyle="bold"
            android:textColor="@color/pulse_on_primary"
            android:background="@drawable/avatar_background"
            android:contentDescription="@string/contact_avatar"/>

        <ImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@string/contact_photo"/>
    </FrameLayout>

    <!-- Name and detail -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/contact_name_size"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="@dimen/contact_detail_size"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="2"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- Call type icon (used in recents) -->
    <ImageView
        android:id="@+id/call_type_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="4dp"
        android:visibility="gone"
        android:importantForAccessibility="no"/>

    <!-- Quick call button -->
    <ImageView
        android:id="@+id/quick_call"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:src="@drawable/ic_call_phone"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/call"
        android:clickable="true"
        android:focusable="true"/>
</LinearLayout>
