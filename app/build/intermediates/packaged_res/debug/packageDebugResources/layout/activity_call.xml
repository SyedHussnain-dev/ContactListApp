<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/call_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="?attr/colorSurface">

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Caller avatar -->
    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp">
        <TextView
            android:id="@+id/caller_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/pulse_on_primary"
            android:background="@drawable/avatar_background"/>
    </FrameLayout>

    <TextView
        android:id="@+id/caller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="28sp"
        android:textColor="?attr/colorOnSurface"
        android:fontFamily="sans-serif-medium"
        android:text="@string/unknown_number"
        android:paddingTop="20dp"/>

    <TextView
        android:id="@+id/call_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurfaceVariant"/>

    <TextView
        android:id="@+id/call_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textSize="20sp"
        android:textColor="?attr/colorOnSurface"
        android:fontFamily="sans-serif-medium"/>

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Action buttons for ringing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="40dp">

        <ImageView
            android:id="@+id/decline"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:padding="24dp"
            android:src="@drawable/ic_end_call"
            android:background="@drawable/bg_end_call"
            android:contentDescription="@string/decline"
            android:elevation="4dp"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/answer"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:padding="24dp"
            android:src="@drawable/ic_call"
            android:background="@drawable/bg_call_button"
            android:contentDescription="@string/answer"
            android:elevation="4dp"/>
    </LinearLayout>

    <!-- Active call controls -->
    <LinearLayout
        android:id="@+id/active_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/mute"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="16dp"
                android:src="@drawable/ic_call"
                android:background="@drawable/bg_call_action_pill"
                android:contentDescription="@string/mute"/>
            <TextView
                android:id="@+id/mute_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mute"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:paddingTop="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/speaker"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="16dp"
                android:src="@drawable/ic_call"
                android:background="@drawable/bg_call_action_pill"
                android:contentDescription="@string/speaker"/>
            <TextView
                android:id="@+id/speaker_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/speaker"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:paddingTop="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/hold"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="16dp"
                android:src="@drawable/ic_call"
                android:background="@drawable/bg_call_action_pill"
                android:contentDescription="@string/hold"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/hold_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hold"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:paddingTop="4dp"
                android:visibility="gone"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/show_keypad"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="16dp"
                android:src="@drawable/ic_dialpad"
                android:background="@drawable/bg_call_action_pill"
                android:contentDescription="@string/keypad"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keypad"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:paddingTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- End call button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="28dp"
        android:paddingBottom="40dp">

        <ImageView
            android:id="@+id/end_call"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:padding="24dp"
            android:src="@drawable/ic_end_call"
            android:background="@drawable/bg_end_call"
            android:contentDescription="@string/end_call"
            android:elevation="4dp"
            android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>
