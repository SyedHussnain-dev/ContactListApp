<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal">

        <!-- Appearance category -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/appearance"
            style="@style/SettingsCategory"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"/>

        <!-- Theme -->
        <include layout="@layout/item_settings_row"
            android:id="@+id/setting_theme"/>

        <!-- Accent -->
        <include layout="@layout/item_settings_row"
            android:id="@+id/setting_accent"/>

        <!-- Density -->
        <include layout="@layout/item_settings_row"
            android:id="@+id/setting_density"/>

        <!-- Haptics -->
        <include layout="@layout/item_settings_row"
            android:id="@+id/setting_haptics"/>

        <!-- Phone category -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/default_phone"
            style="@style/SettingsCategory"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"/>

        <include layout="@layout/item_settings_row"
            android:id="@+id/setting_default_phone"/>

        <!-- Privacy category -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy"
            style="@style/SettingsCategory"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"/>

        <include layout="@layout/item_settings_row"
            android:id="@+id/setting_privacy"/>

        <!-- About category -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about"
            style="@style/SettingsCategory"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"/>

        <include layout="@layout/item_settings_row"
            android:id="@+id/setting_about"/>
    </LinearLayout>
</ScrollView>
