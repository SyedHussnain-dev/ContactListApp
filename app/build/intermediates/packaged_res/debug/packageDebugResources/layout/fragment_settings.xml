<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipToPadding="false"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal">

        <!-- Appearance category -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/appearance"
            style="@style/SettingsCategory"
            android:paddingTop="16dp"
            android:paddingBottom="10dp"
            android:paddingStart="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:paddingVertical="4dp">

            <include layout="@layout/item_settings_row"
                android:id="@+id/setting_theme"/>

            <include layout="@layout/item_settings_row"
                android:id="@+id/setting_accent"/>

            <include layout="@layout/item_settings_row"
                android:id="@+id/setting_density"/>

            <include layout="@layout/item_settings_row"
                android:id="@+id/setting_haptics"/>
        </LinearLayout>

        <!-- Phone category -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/default_phone"
            style="@style/SettingsCategory"
            android:paddingTop="24dp"
            android:paddingBottom="10dp"
            android:paddingStart="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:paddingVertical="4dp">

            <include layout="@layout/item_settings_row"
                android:id="@+id/setting_default_phone"/>
        </LinearLayout>

        <!-- Privacy category -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy"
            style="@style/SettingsCategory"
            android:paddingTop="24dp"
            android:paddingBottom="10dp"
            android:paddingStart="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:paddingVertical="4dp">

            <include layout="@layout/item_settings_row"
                android:id="@+id/setting_privacy"/>
        </LinearLayout>

        <!-- About category -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about"
            style="@style/SettingsCategory"
            android:paddingTop="24dp"
            android:paddingBottom="10dp"
            android:paddingStart="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:paddingVertical="4dp">

            <include layout="@layout/item_settings_row"
                android:id="@+id/setting_about"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
