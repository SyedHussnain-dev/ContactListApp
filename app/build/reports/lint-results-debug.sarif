                                        "text": "    <string name=\"add_favorite\">Add to favorites</string><string name=\"remove_favorite\">Remove from favorites</string><string name=\"favorite_permission\">Pulse Dialer needs contact edit permission for this change. Grant it when Android asks, then repeat the action.</string><string name=\"edit\">Edit contact</string><string name=\"share\">Share</string><string name=\"delete\">Delete</string><string name=\"delete_contact\">Delete contact?</string><string name=\"delete_confirmation\">Remove %1$s from your device contacts? This cannot be undone.</string><string name=\"contact_deleted\">Contact deleted</string><string name=\"contact_delete_failed\">Contact could not be deleted.</string>\n    <string name=\"jump_to_letter\">Jump to contacts beginning with %1$s</string>\n    <string name=\"choose_sim\">Choose calling account</string><string name=\"sim_label\">SIM %1$d</string><string name=\"call_account_label\">Phone account %1$d</string><string name=\"call_using_account\">Call using %1$s</string>\n    <string name=\"incoming_calls\">Incoming calls</string><string name=\"call_ringing\">Incoming call</string><string name=\"call_dialing\">Calling</string><string name=\"call_connecting\">Connecting</string><string name=\"call_active\">Connected</string><string name=\"call_holding\">On hold</string><string name=\"call_disconnected\">Call ended</string><string name=\"call_ongoing\">Call in progress</string>\n    <string name=\"answer\">Answer</string><string name=\"decline\">Decline</string><string name=\"end_call\">End call</string><string name=\"mute\">Mute</string><string name=\"unmute\">Unmute</string><string name=\"speaker\">Speaker</string><string name=\"speaker_on\">Speaker on</string><string name=\"hold\">Hold</string><string name=\"resume\">Resume</string><string name=\"keypad\">Keypad</string><string name=\"dtmf_keypad\">Call keypad</string><string name=\"loading\">Loading…</string>\n"
                                    }
                                }
                            }
                        }
                    ],
