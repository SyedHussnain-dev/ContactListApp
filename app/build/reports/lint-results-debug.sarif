                                    "endLine": 62,
                                    "snippet": {
                                        "text": "    private void loadData(){if(tab==R.id.nav_contacts){message.setText(R.string.loading);message.setVisibility(View.VISIBLE);WORKER.execute(()->{List<ContactRepository.Contact> result=ContactRepository.contacts(requireContext().getApplicationContext());if(getActivity()!=null)getActivity().runOnUiThread(()->{contacts=result;message.setVisibility(View.GONE);render();});});}else{message.setText(R.string.loading);message.setVisibility(View.VISIBLE);WORKER.execute(()->{List<ContactRepository.Recent> result=ContactRepository.recents(requireContext().getApplicationContext());if(getActivity()!=null)getActivity().runOnUiThread(()->{recents=result;message.setVisibility(View.GONE);render();});});}}\n    @Override public void onResume(){super.onResume();if(firstResume){firstResume=false;return;}if(adapter!=null){if(tab==R.id.nav_contacts&&MainActivity.hasPermission(requireContext(),Manifest.permission.READ_CONTACTS))loadData();if(tab==R.id.nav_recents&&MainActivity.isDefaultDialer(requireContext())&&MainActivity.hasPermission(requireContext(),Manifest.permission.READ_CALL_LOG))loadData();if(tab==R.id.nav_sim&&MainActivity.hasPermission(requireContext(),Manifest.permission.READ_PHONE_STATE))loadAccounts();}}\n    private void render(){if(adapter==null)return;adapter.rows.clear();String q=search==null?\"\":search.getText().toString().trim().toLowerCase(Locale.getDefault());if(tab==R.id.nav_contacts){List<ContactRepository.Contact> result=new ArrayList<>();for(ContactRepository.Contact c:contacts)if(q.isEmpty()||(c.name!=null&&c.name.toLowerCase(Locale.getDefault()).contains(q))||(c.number!=null&&c.number.toLowerCase(Locale.getDefault()).contains(q)))result.add(c);java.text.Collator collator=java.text.Collator.getInstance();Collections.sort(result,(a,b)->{int favorite=Boolean.compare(b.starred,a.starred);if(favorite!=0)return favorite;return collator.compare(a.name==null?\"\":a.name,b.name==null?\"\":b.name);});adapter.rows.addAll(result);}else{for(ContactRepository.Recent c:recents){if(!filter.equals(\"All\")&&!filter.equals(c.kind()))continue;String name=c.name==null||c.name.trim().isEmpty()?c.number:c.name;if(q.isEmpty()||(name!=null&&name.toLowerCase(Locale.getDefault()).contains(q))||(c.number!=null&&c.number.toLowerCase(Locale.getDefault()).contains(q)))adapter.rows.add(c);}}adapter.notifyDataSetChanged();if(adapter.getItemCount()==0&&message.getVisibility()!=View.VISIBLE){message.setVisibility(View.VISIBLE);message.setText(q.isEmpty()?(tab==R.id.nav_contacts?R.string.empty_contacts:R.string.empty_recents):R.string.no_results);}else if(adapter.getItemCount()>0)message.setVisibility(View.GONE);}\n    private void loadAccounts(){if(ContextCompat.checkSelfPermission(requireContext(),Manifest.permission.READ_PHONE_STATE)!=PackageManager.PERMISSION_GRANTED){message.setText(R.string.sim_permission);return;}TelecomManager tm=(TelecomManager)requireContext().getSystemService(android.content.Context.TELECOM_SERVICE);if(tm==null){message.setText(R.string.no_telecom);return;}try{List<PhoneAccountHandle> accounts=tm.getCallCapablePhoneAccounts();if(accounts==null||accounts.isEmpty()){message.setText(R.string.no_sim_accounts);return;}StringBuilder out=new StringBuilder(getString(R.string.accounts_heading));for(int i=0;i<accounts.size();i++){PhoneAccountHandle h=accounts.get(i);android.telecom.PhoneAccount a=tm.getPhoneAccount(h);out.append(\"\\n\\n\").append(a==null?getString(R.string.call_account_label,i+1):a.getLabel()).append(\"\\n\").append(a==null?\"\":a.getShortDescription());}out.append(\"\\n\\n\").append(getString(R.string.sim_contacts_limited));message.setText(out);message.setVisibility(View.VISIBLE);}catch(SecurityException e){message.setText(R.string.no_sim_accounts);}}\n    private void rowAction(Object row){if(row instanceof ContactRepository.Contact){ContactRepository.Contact c=(ContactRepository.Contact)row;String[] actions={getString(R.string.call),getString(R.string.message_action),getString(R.string.details),getString(c.starred?R.string.remove_favorite:R.string.add_favorite),getString(R.string.edit),getString(R.string.share),getString(R.string.delete)};new AlertDialog.Builder(requireContext()).setTitle(c.name).setItems(actions,(d,w)->{if(w==0)((MainActivity)requireActivity()).openDialpad(c.number);else if(w==1)message(c.number);else if(w==2)contactDetails(c);else if(w==3)favorite(c);else if(w==4)edit(c);else if(w==5)share(c);else delete(c);}).show();}else if(row instanceof ContactRepository.Recent){ContactRepository.Recent c=(ContactRepository.Recent)row;String[] actions={getString(R.string.call_back),getString(R.string.details),getString(R.string.message_action),getString(R.string.add_contact)};new AlertDialog.Builder(requireContext()).setTitle(c.name==null?c.number:c.name).setItems(actions,(d,w)->{if(w==0)((MainActivity)requireActivity()).openDialpad(c.number);else if(w==1)new AlertDialog.Builder(requireContext()).setTitle(R.string.call_details).setMessage((c.name==null?getString(R.string.unknown_number):c.name)+\"\\n\"+c.number+\"\\n\"+c.kind()+\"\\n\"+ContactRepository.dateLabel(c.date)+\"\\n\"+getString(R.string.duration_label,ContactRepository.duration(c.duration))+(c.account==null?\"\":\"\\n\"+c.account)).setPositiveButton(android.R.string.ok,null).show();else if(w==2)message(c.number);else addContact(c.number);}).show();}}\n"
                                    }
                                }
                            }
                        }
                    ],
