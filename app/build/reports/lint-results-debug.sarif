                                        "text": "    private void delete(ContactRepository.Contact c){if(!MainActivity.hasPermission(requireContext(),Manifest.permission.WRITE_CONTACTS)){new AlertDialog.Builder(requireContext()).setMessage(R.string.favorite_permission).setPositiveButton(R.string.grant_permission,(d,w)->((MainActivity)requireActivity()).requestContactWriteAccess()).setNegativeButton(android.R.string.cancel,null).show();return;}new AlertDialog.Builder(requireContext()).setTitle(R.string.delete_contact).setMessage(getString(R.string.delete_confirmation,c.name==null?\"\":c.name)).setNegativeButton(android.R.string.cancel,null).setPositiveButton(R.string.delete,(d,w)->{android.content.Context app=requireContext().getApplicationContext();WORKER.execute(()->{int count=0;try{count=app.getContentResolver().delete(Uri.withAppendedPath(android.provider.ContactsContract.Contacts.CONTENT_URI,String.valueOf(c.id)),null,null);}catch(SecurityException ignored){}int deleted=count;if(getActivity()!=null)getActivity().runOnUiThread(()->{Toast.makeText(requireContext(),deleted>0?R.string.contact_deleted:R.string.contact_delete_failed,Toast.LENGTH_SHORT).show();loadData();});});}).show();}\n    private void favorite(ContactRepository.Contact c){if(!MainActivity.hasPermission(requireContext(),Manifest.permission.WRITE_CONTACTS)){new AlertDialog.Builder(requireContext()).setMessage(R.string.favorite_permission).setPositiveButton(R.string.grant_permission,(d,w)->((MainActivity)requireActivity()).requestContactWriteAccess()).setNegativeButton(android.R.string.cancel,null).show();return;}android.content.ContentValues v=new android.content.ContentValues();v.put(android.provider.ContactsContract.Contacts.STARRED,c.starred?0:1);android.content.Context app=requireContext().getApplicationContext();WORKER.execute(()->{try{app.getContentResolver().update(Uri.withAppendedPath(android.provider.ContactsContract.Contacts.CONTENT_URI,String.valueOf(c.id)),v,null,null);if(getActivity()!=null)getActivity().runOnUiThread(this::loadData);}catch(SecurityException ignored){}});}\n    private static class RowAdapter extends RecyclerView.Adapter<RowHolder>{final List<Object> rows=new ArrayList<>();@NonNull public RowHolder onCreateViewHolder(@NonNull ViewGroup p,int t){return new RowHolder(LayoutInflater.from(p.getContext()).inflate(R.layout.item_contact,p,false));}public void onBindViewHolder(@NonNull RowHolder h,int i){Object row=rows.get(i);android.content.Context context=h.itemView.getContext();boolean compact=context.getSharedPreferences(\"MainActivity\",0).getBoolean(\"compact\",false);int vertical=(int)((compact?5:10)*context.getResources().getDisplayMetrics().density);h.itemView.setPadding(h.itemView.getPaddingLeft(),vertical,h.itemView.getPaddingRight(),vertical);h.photo.setTag(null);if(row instanceof ContactRepository.Contact){ContactRepository.Contact c=(ContactRepository.Contact)row;h.name.setText((c.starred?\"★  \":\"\")+(c.name==null||c.name.isEmpty()?context.getString(R.string.unknown_contact):c.name));h.detail.setText(c.number==null?context.getString(R.string.no_phone):c.number);h.avatar.setText(initials(c.name));h.photo.setImageDrawable(null);h.photo.setVisibility(View.GONE);if(c.photo!=null){h.photo.setTag(c.photo.toString());WORKER.execute(()->{Bitmap image=null;try(java.io.InputStream in=context.getContentResolver().openInputStream(c.photo)){if(in!=null)image=BitmapFactory.decodeStream(in);}catch(Exception ignored){}Bitmap result=image;if(result!=null)h.itemView.post(()->{if(c.photo.toString().equals(h.photo.getTag())){h.photo.setImageBitmap(result);h.photo.setVisibility(View.VISIBLE);}});});}}else{ContactRepository.Recent c=(ContactRepository.Recent)row;String title=c.name==null||c.name.isEmpty()?context.getString(R.string.unknown_number):c.name;h.name.setText(title);h.detail.setText(c.kind()+\" · \"+(c.number==null?\"\":c.number)+\"\\n\"+ContactRepository.dateLabel(c.date)+\" · \"+ContactRepository.duration(c.duration));h.avatar.setText(c.type==android.provider.CallLog.Calls.MISSED_TYPE||c.type==android.provider.CallLog.Calls.REJECTED_TYPE?\"!\":\"↗\");h.photo.setImageDrawable(null);h.photo.setVisibility(View.GONE);}h.itemView.setOnClickListener(v->{if(context instanceof androidx.fragment.app.FragmentActivity){androidx.fragment.app.FragmentActivity a=(androidx.fragment.app.FragmentActivity)context;Fragment f=a.getSupportFragmentManager().findFragmentById(R.id.content);if(f instanceof ListFragment)((ListFragment)f).rowAction(row);}});}public int getItemCount(){return rows.size();}private static String initials(String name){if(name==null||name.trim().isEmpty())return \"•\";String[] s=name.trim().split(\"\\\\s+\");return (s[0].substring(0,1)+(s.length>1?s[s.length-1].substring(0,1):\"\")).toUpperCase(Locale.getDefault());}}\n    private static class RowHolder extends RecyclerView.ViewHolder{TextView name,detail,avatar;ImageView photo;RowHolder(View v){super(v);name=v.findViewById(R.id.name);detail=v.findViewById(R.id.detail);avatar=v.findViewById(R.id.avatar);photo=v.findViewById(R.id.photo);}}\n}\n"
