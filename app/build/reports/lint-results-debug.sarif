ext(c.type==android.provider.CallLog.Calls.MISSED_TYPE||c.type==android.provider.CallLog.Calls.REJECTED_TYPE?\"!\":\"↗\");h.photo.setImageDrawable(null);h.photo.setVisibility(View.GONE);}h.itemView.setOnClickListener(v->{if(context instanceof androidx.fragment.app.FragmentActivity){androidx.fragment.app.FragmentActivity a=(androidx.fragment.app.FragmentActivity)context;Fragment f=a.getSupportFragmentManager().findFragmentById(R.id.content);if(f instanceof ListFragment)((ListFragment)f).rowAction(row);}});}public int getItemCount(){return rows.size();}private static String initials(String name){if(name==null||name.trim().isEmpty())return \"•\";String[] s=name.trim().split(\"\\\\s+\");return (s[0].substring(0,1)+(s.length>1?s[s.length-1].substring(0,1):\"\")).toUpperCase(Locale.getDefault());}}\n    private static class RowHolder extends RecyclerView.ViewHolder{TextView name,detail,avatar;ImageView photo;RowHolder(View v){super(v);name=v.findViewById(R.id.name);detail=v.findViewById(R.id.detail);avatar=v.findViewById(R.id.avatar);photo=v.findViewById(R.id.photo);}}\n}\n"
                                    }
                                }
                            }
                        }
