<resources>
    <style name="Theme.PulseDialer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pulse_primary</item>
        <item name="colorOnPrimary">@color/pulse_on_primary</item>
        <item name="colorPrimaryContainer">@color/pulse_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/pulse_on_primary_container</item>
        <item name="colorSecondary">@color/pulse_secondary</item>
        <item name="colorSecondaryContainer">@color/pulse_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/pulse_on_secondary_container</item>
        <item name="colorSurface">@color/pulse_surface</item>
        <item name="colorOnSurface">@color/pulse_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/pulse_on_surface_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/pulse_surface_main</item>
        <item name="colorSurfaceContainer">@color/pulse_surface_variant</item>
        <item name="colorSurfaceContainerHigh">@color/pulse_surface_elevated</item>
        <item name="colorSurfaceContainerHighest">@color/pulse_surface_elevated</item>
        <item name="colorOutline">@color/pulse_outline</item>
        <item name="colorOutlineVariant">@color/pulse_outline_variant</item>
        <item name="colorError">@color/pulse_error</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="bottomSheetDialogTheme">@style/PulseBottomSheet</item>
        <item name="shapeAppearanceMediumComponent">@style/PulseShapeMedium</item>
        <item name="shapeAppearanceLargeComponent">@style/PulseShapeLarge</item>
        <item name="materialButtonStyle">@style/Widget.Pulse.Button</item>
    </style>

    <style name="PulseBottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/PulseBottomSheetStyle</item>
    </style>

    <style name="PulseBottomSheetStyle" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/PulseBottomSheetShape</item>
        <item name="backgroundTint">@color/bottom_sheet_bg</item>
    </style>

    <style name="PulseBottomSheetShape" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="PulseShapeMedium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="PulseShapeLarge" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.Pulse.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Dialpad key style -->
    <style name="DialpadKey" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/dialpad_key_text</item>
        <item name="backgroundTint">@color/dialpad_key_bg</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:gravity">center</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Filter chip style -->
    <style name="PulseFilterChip" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">20dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- Action pill button -->
    <style name="ActionPill" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">24dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">6dp</item>
    </style>

    <!-- Settings row -->
    <style name="SettingsCategory" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/pulse_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="SettingsTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/pulse_on_surface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="SettingsSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/pulse_on_surface_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
